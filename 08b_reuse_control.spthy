/*
==============================================================================
  PoC 08b -- control for 08: identical theory, [reuse] attribute removed
==============================================================================

  This file is identical to attacks/08_reuse_poisons_both_directions.spthy
  except that the single token `[reuse]` has been deleted from `helper`, and
  the theory renamed.  Nothing else differs: same rule, same three lemmas,
  same order.

  ---------------------------------------------------------------------------
  TAMARIN SAYS (all three correct)
  ---------------------------------------------------------------------------
    helper (all-traces):   falsified - found trace (3 steps)
    target (all-traces):   falsified - found trace (3 steps)
    live   (exists-trace): verified (3 steps)

  ---------------------------------------------------------------------------
  TAMARIN SAYS FOR 08 (same theory, [reuse] restored)
  ---------------------------------------------------------------------------
    helper (all-traces):   falsified - found trace (3 steps)
    target (all-traces):   verified (2 steps)                  <-- WRONG
    live   (exists-trace): falsified - no trace found (2 steps) <-- WRONG

  ---------------------------------------------------------------------------
  WHAT THE CONTROL ESTABLISHES
  ---------------------------------------------------------------------------
  Deleting one attribute token flips two verdicts, in opposite directions,
  without touching the protocol or the properties.  That isolates the cause:
  the wrong answers in 08 come from the refuted `helper` being admitted as an
  assumption via `gatherReusableLemmas`, and from nothing else in the model.

  It also fixes the ground truth, so 08's self-contradiction can be resolved:
  `live` is TRUE and `target` is FALSE.  The verdicts 08 gives for both are
  wrong.
==============================================================================
*/

theory ReuseControl begin

rule Gen: [ Fr(k) ] --[ Secret(k) ]-> [ Out(k) ]

lemma helper:
  "All k #i #j. Secret(k) @ i & KU(k) @ j ==> F"

lemma target:
  "All k #i. Secret(k) @ i ==> not(Ex #j. KU(k) @ j)"

lemma live: exists-trace
  "Ex k #i #j. Secret(k) @ i & KU(k) @ j"

end
